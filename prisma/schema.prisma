generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    String @id @default(cuid())
  slug  String @unique
  label String

  users   UserRole[]
  invites Invite[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles             UserRole[]
  ownedEquipment    Equipment[] @relation("EquipmentOwner")
  equippedEquipment Equipment[] @relation("EquipmentEquippedBy")
  invitesCreated    Invite[]    @relation("InviteCreatedBy")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  roleId      String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  role      Role @relation(fields: [roleId], references: [id])
  createdBy User @relation("InviteCreatedBy", fields: [createdById], references: [id])
}

// A null ownerId means the item belongs to the clan's shared pool rather
// than to one member. equippedByUserId tracks who currently has a slotted
// item on their loadout — the owner themself for personal gear, or a
// borrower for clan gear. Only items with a `slot` show up on the paperdoll;
// un-slotted items (camping gear, cooking gear...) stay list-only.
model Equipment {
  id               String   @id @default(cuid())
  name             String
  category         String
  description      String?
  slot             String?
  ownerId          String?
  equippedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner      User? @relation("EquipmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  equippedBy User? @relation("EquipmentEquippedBy", fields: [equippedByUserId], references: [id], onDelete: SetNull)
}
